+    def _open_upstream_auto(self, payload, realms, session_key=None,
+                            prebuilt_body=None, model=None,
+                            defer_egress_success=False, **open_kwargs):
+        """按顺序尝试多个区域打开上游；当前区拿不到可用账号时自动回退。
+
+        只在「池子真的空了/被封死」的两类失败上换区：
+          * RuntimeError("no usable account ...") —— open_upstream 的池空结论
+          * RateLimited —— 全区每日额度用尽 / 模型频控
+        其他错误（内容 403、参数 4xx、上游 502）不换区：换区不会改变结果，
+        只会把同一个错再撞一遍。全部区域失败时重抛第一个异常。
+        成功后把实际出口与原因写到 self.realm_used / self.realm_reason，
+        响应头（X-WB-Realm / X-WB-Realm-Reason）与用量行据此可见。
+        """
+        model = model or str(payload.get("model") or "")
+        first_exc = None
+        for index, realm in enumerate(realms):
+            try:
+                extra = {}
+                if defer_egress_success:
+                    # 只在需要时传：老的调用方/测试替身没有这个形参。
+                    extra["defer_egress_success"] = True
+                upstream, account, effort = open_upstream(
+                    payload, session_key=session_key, target_realm=realm,
+                    prebuilt_body=prebuilt_body, **extra, **open_kwargs)
+                reason = ""
+                if index > 0:
+                    reason = "no_account"
+                    log("auto realm fallback: realm %s unavailable -> serving "
+                        "%s (model=%s)" % (realms[0], realm, model), tag="realm")
+                self.realm_used = realm
+                self.realm_reason = reason
+                return upstream, account, effort
+            except RateLimited as exc:
+                if first_exc is None:
+                    first_exc = exc
+                log("auto realm fallback: realm %s rate-limited; trying next"
+                    % realm, tag="realm")
+                continue
+            except RuntimeError as exc:
+                if str(exc).startswith("no usable account"):
+                    if first_exc is None:
+                        first_exc = exc
+                    log("auto realm fallback: realm %s has no usable account; "
+                        "trying next" % realm, tag="realm")
+                    continue
+                raise
+        raise first_exc
+
