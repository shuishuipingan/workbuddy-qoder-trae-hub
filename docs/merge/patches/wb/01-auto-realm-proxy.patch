+def realm_candidates(model, requested=None):
+    """本次请求应尝试的区域（按顺序）。智能路由规则：
+
+      1. 区域独占模型：只试它所在的区域（另一区上游根本没有这个模型）。
+      2. 显式指定（?realm= / Key 绑定 / X-Realm）：尊重显式，但允许在
+         「该区无可用账号」时回退另一区（前提是另一区有这个模型）。
+      3. 自动（未显式指定）：prefer（默认 cn）优先；若 prefer 区当前一个
+         可用账号都没有而另一区有，直接换序 —— 一次命中，不必先撞一次失败。
+    返回列表至少有一个元素；自动路由关闭时等价于旧行为（单元素）。
+    """
+    owner = exclusive_realm(model)
+    try:
+        cfg = wb_settings.realm_routing(ACCOUNTS_DIR)
+    except Exception:
+        cfg = {"enabled": True, "prefer": "cn"}
+    enabled = bool(cfg.get("enabled")) and AUTO_REALM_ENABLED
+    if requested:
+        realms = [requested]
+        if not enabled or requested not in ("cn", "intl")                 or owner not in ("", requested):
+            return realms
+        other = "intl" if requested == "cn" else "cn"
+        return [requested, other]
+    if owner:
+        return [owner]
+    if not enabled:
+        return [CURRENT_REALM]
+    prefer = cfg.get("prefer") or "cn"
+    other = "intl" if prefer == "cn" else "cn"
+    try:
+        if POOL is not None \
+                and POOL.count_ready(prefer, model=model or None) == 0 \
+                and POOL.count_ready(other, model=model or None) > 0:
+            return [other, prefer]
+    except Exception as exc:
+        log("auto realm readiness probe skipped: %s" % exc)
+    return [prefer, other]
+
